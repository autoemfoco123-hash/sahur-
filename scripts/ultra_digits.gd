## The digit as a mesh, `height` metres tall.
static func mesh(ch: String, height: float, mat: Material) -> ArrayMesh:
	var d = D6 if ch == "6" else D7
	var v = PoolVector3Array()
	var n = PoolVector3Array()
	var uv = PoolVector2Array()
	var k = 0
	while k < d[0].size():
		v.append(Vector3(d[0][k], d[0][k + 1], d[0][k + 2]) * height)
		n.append(Vector3(d[1][k], d[1][k + 1], d[1][k + 2]).normalized())
		k += 3
	k = 0
	while k < d[2].size():
		uv.append(Vector2(d[2][k], d[2][k + 1]))
		k += 2
	var arr = []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = v
	arr[Mesh.ARRAY_NORMAL] = n
	arr[Mesh.ARRAY_TEX_UV] = uv
	arr[Mesh.ARRAY_INDEX] = PoolIntArray(d[3])
	var am = ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	am.surface_set_material(0, mat)
	return am
